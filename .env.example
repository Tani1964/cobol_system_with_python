# Copy to .env and change every value. Never commit .env.
MONGO_USER=cbsadmin
MONGO_PASSWORD=change-me-to-a-long-random-password
MONGO_DB=cbs
# Public hostname for HTTPS (docker compose --profile https ...).
# Its DNS A record must point at the server.
DOMAIN=bank-api.example.com
# Load the fictional demo data the first time the volume is empty.
CBS_SEED_ON_FIRST_START=true
# Using MongoDB Atlas instead of the bundled container? Set this and
# start with: docker compose up -d --no-deps --build api
# MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
